# Tomcat RewriteValve rules, applied before the servlet chain.

# 1. Railway's healthcheckPath accepts only letters, digits, "/" and "_", so
#    Kill Bill's real probe path (/1.0/healthcheck) is unusable as written.
RewriteRule ^/healthz$ /1.0/healthcheck [L]

# 2. Kill Bill registers /1.0/metrics and /1.0/threads outside Shiro, so both
#    answer 200 to anonymous callers — /1.0/threads returns a full stack dump of
#    every thread. Neither is needed by Kaui or by any client, and the public
#    domain is the whole internet, so refuse them. Remove these two rules if you
#    want to scrape the metrics endpoint and have put your own gateway in front.
RewriteRule ^/1\.0/metrics$ - [F]
RewriteRule ^/1\.0/threads$ - [F]
